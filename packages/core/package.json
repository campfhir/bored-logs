      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/campfhir/bored-logs.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/campfhir/bored-logs/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/campfhir/bored-logs/issues"
  },
