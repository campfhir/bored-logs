{
  "name": "bored-logs-monorepo",
  "private": true,
  "version": "0.8.0",
  "description": "Monorepo for the @campfhir/bored-logs packages — structured PostgreSQL-backed logging for React + Node, published as constituent packages under packages/*.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/campfhir/bored-logs.git"
  },
  "homepage": "https://github.com/campfhir/bored-logs#readme",
  "bugs": {
    "url": "https://github.com/campfhir/bored-logs/issues"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fuzz": "FUZZ_ITER=8000 vitest run packages/server/src/__tests__/fuzz.test.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "bench": "vitest bench --run",
    "bench:e2e": "vitest bench --run --config vitest.e2e.config.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "demo": "docker compose -f demos/web/compose.yaml up --build",
    "demo:down": "docker compose -f demos/web/compose.yaml down -v",
    "publish:npm": "pnpm -r publish --access public",
    "publish:jsr": "pnpm -r --workspace-concurrency=1 exec npx jsr publish"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26",
    "kysely": "^0.27.0",
    "pg": "^8",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3"
  }
}
