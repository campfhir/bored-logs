{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      // Resolve each library package under its published name from the LOCAL
      // SOURCE in ../../../packages (tsx honours tsconfig paths) — no build
      // step. The `link:` dependencies (→ dist) are the fallback.
      "@campfhir/bored-logs": ["../../../packages/core/src/index.ts"],
      "@campfhir/bored-logs-server": ["../../../packages/server/src/index.ts"],
      "@campfhir/bored-logs-psql": ["../../../packages/psql/src/index.ts"],
      "@campfhir/bored-logs-psql-migration": ["../../../packages/psql-migration/src/index.ts"],
      "@campfhir/bored-logs-http": ["../../../packages/http/src/index.ts"]
    }
  },
  "include": ["*.ts"]
}
