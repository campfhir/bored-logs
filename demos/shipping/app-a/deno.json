{
  "unstable": ["sloppy-imports"],
  "compilerOptions": {
    // The library's universal modules reference guarded Node/browser globals
    // (process, Buffer, document); pull in both type worlds for `deno check`.
    "lib": ["deno.ns", "dom", "esnext"],
    "types": ["npm:@types/node"]
  },
  "imports": {
    "@campfhir/bored-logs": "../../../packages/core/src/index.ts",
    "@campfhir/bored-logs-http": "../../../packages/http/src/index.ts"
  },
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read --allow-write main.ts"
  }
}
